# `cli2api run --adapter auto -- your-command` injects client variables for you.
# For a persistent server, point any supported client surface at cli2api:
OPENAI_BASE_URL=http://127.0.0.1:3927/v1
# Some OpenAI-compatible clients use this legacy alias instead:
# OPENAI_API_BASE=http://127.0.0.1:3927/v1
OPENAI_API_KEY=local-dev
OPENAI_MODEL=mock/echo

# OpenRouter aliases use the same token:
# OPENROUTER_BASE_URL=http://127.0.0.1:3927/api/v1
# OPENROUTER_API_KEY=local-dev

# Anthropic Messages uses the server root and the same token:
# ANTHROPIC_BASE_URL=http://127.0.0.1:3927
# ANTHROPIC_API_KEY=local-dev
# ANTHROPIC_AUTH_TOKEN=local-dev
# ANTHROPIC_MODEL=mock/echo

# Mock requires no CLI. Real model prefixes:
# OPENAI_MODEL=codex/default
# OPENAI_MODEL=opencode/deepseek-v4-flash-free
# OPENAI_MODEL=cursor/composer-2.5-fast
# OPENAI_MODEL=claude/default
# OPENAI_MODEL=gemini/default
# OPENAI_MODEL=qwen/default
# OPENAI_MODEL=copilot/default

# Optional cli2api server settings:
# CLI2API_ADAPTER=auto
# CLI2API_TOKEN=local-dev
# CLI2API_PORT=3927
# CLI2API_CONFIG=/path/to/trusted-config.json
# CLI2API_CODEX_BIN=codex
# CLI2API_OPENCODE_BIN=opencode
# CLI2API_CURSOR_BIN=cursor-agent
# CLI2API_CLAUDE_BIN=claude
# CLI2API_GEMINI_BIN=gemini
# CLI2API_QWEN_BIN=qwen
# CLI2API_COPILOT_BIN=copilot

# Omit CWD for a fresh empty workspace; setting it explicitly exposes that path:
# CLI2API_CWD=/path/to/workspace
# CLI2API_MAX_CONCURRENCY=2
# CLI2API_MAX_QUEUE=16
# CLI2API_MAX_BODY_BYTES=2097152
# CLI2API_OPENROUTER_CATALOG=runnable
# In the server environment, OPENROUTER_API_KEY optionally authenticates only
# canonical OpenRouter metadata refreshes.

# Explicit extra parent env names to pass to scrubbed child processes:
# CLI2API_CHILD_ENV_ALLOWLIST=MY_PROVIDER_API_KEY
