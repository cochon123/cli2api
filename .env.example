# Point any OpenAI-compatible client at cli2api:
OPENAI_BASE_URL=http://127.0.0.1:3927/v1
OPENAI_API_KEY=local-dev

# Mock (no CLI required):
OPENAI_MODEL=mock/echo

# Or Codex (requires `codex` on PATH, logged in):
# OPENAI_MODEL=codex/default
# Or OpenCode / Cursor Agent / Claude Code:
# OPENAI_MODEL=opencode/deepseek-v4-flash-free
# OPENAI_MODEL=cursor/composer-2.5-fast
# OPENAI_MODEL=claude/default

# Optional cli2api server settings:
# CLI2API_ADAPTER=mock
# CLI2API_TOKEN=local-dev
# CLI2API_CODEX_BIN=codex
# CLI2API_OPENCODE_BIN=opencode
# CLI2API_CURSOR_BIN=cursor-agent
# CLI2API_CLAUDE_BIN=claude
# CLI2API_CWD=/path/to/workspace
# Explicit extra parent env names to pass to scrubbed child processes:
# CLI2API_CHILD_ENV_ALLOWLIST=MY_PROVIDER_API_KEY
