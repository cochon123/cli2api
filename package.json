{
  "name": "@cochon123/cli2api",
  "version": "0.1.0",
  "description": "Local OpenAI- and OpenRouter-compatible gateway for coding CLIs",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "cli2api": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cochon123/cli2api.git"
  },
  "homepage": "https://github.com/cochon123/cli2api#readme",
  "bugs": {
    "url": "https://github.com/cochon123/cli2api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node scripts/postbuild.mjs",
    "start": "node dist/index.js",
    "serve": "tsx src/index.ts serve",
    "doctor": "tsx src/index.ts doctor",
    "models": "tsx src/index.ts models",
    "completion": "tsx src/index.ts completion",
    "adapters": "tsx src/index.ts adapters",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:adapters": "tsx scripts/adapter-contract.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:adapters && npm run test:smoke",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "openai",
    "openrouter",
    "cli",
    "codex",
    "local",
    "llm-gateway"
  ],
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "ajv": "^8.20.0",
    "commander": "^14.0.0",
    "hono": "^4.8.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
